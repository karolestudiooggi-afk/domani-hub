# =====================================================================
# Domani Social Hub — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha. O `.env` NÃO vai para o git.
# =====================================================================

# ---------------------------------------------------------------------
# 1. SUPABASE  (obrigatório)
#    Dashboard → Settings → API
#    A anon/publishable key é pública por design — quem protege os dados
#    é o RLS, não o segredo da chave.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL="https://SEU-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key"

# Nome da organização criada no primeiro login (opcional)
VITE_ORG_NAME="Domani"

# Schema do banco (exponha em Settings → API → Exposed schemas)
VITE_DB_SCHEMA="domani_hub"

# =====================================================================
# ATENÇÃO: daqui pra baixo NÃO é arquivo .env.
#
# Estas chaves são SECRETAS e ficam no servidor — nunca no front-end,
# ou vazariam no bundle que qualquer visitante baixa.
#
# Configure em:  Supabase Dashboard → Edge Functions → Secrets
#            ou: npx supabase secrets set NOME=valor
# =====================================================================
#
# OBRIGATÓRIA — a IA do app (texto e imagem):
#   OPENAI_API_KEY=sk-...
#
# OBRIGATÓRIA — protege o cron do autopilot (invente uma string longa
# e aleatória; sem ela, qualquer um dispara sua automação):
#   CRON_SECRET=...
#
# OPCIONAIS — cada uma liga uma integração. Sem elas o app funciona
# normalmente, só sem aquela funcionalidade:
#   OPENAI_TEXT_MODEL=gpt-4o-mini      (padrão; troque se quiser)
#   OPENAI_IMAGE_MODEL=gpt-image-1     (padrão)
#   PEXELS_API_KEY=...                 (banco de imagens — grátis)
#   FIRECRAWL_API_KEY=...              (extração de sites — free tier)
#   APIFY_API_TOKEN=...                (analytics das redes)
#
# As chaves de PUBLICAÇÃO (Post for Me) e de VÍDEO (Higgsfield) são
# preenchidas pelo próprio usuário na tela de Configurações do app e
# ficam salvas no banco — não precisam entrar aqui.
